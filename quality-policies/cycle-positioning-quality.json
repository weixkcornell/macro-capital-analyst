{
  "id": "cycle-positioning.quality",
  "version": "2.1.0",
  "schemaVersion": 2,
  "appliesToScenario": "cycle-positioning",
  "gates": [
    {
      "id": "no-banned-tokens",
      "severity": "hard",
      "description": "禁例 token 0 命中：书目痕迹、需脱敏量值、禁用表述逐 token 扫描",
      "bannedTokens": ["某书认为", "【替换："]
    },
    {
      "id": "net-alpha-required",
      "severity": "hard",
      "description": "任何配置结论必须给出 毛 α − 摩擦 = 净 α，净 α ≤ 0 不发布"
    },
    {
      "id": "numbers-match-dataset",
      "severity": "hard",
      "description": "正文所有数字与数据底座表逐 token 一致"
    },
    {
      "id": "placeholder-clean",
      "severity": "hard",
      "description": "全文无【替换：…】占位符残留"
    },
    {
      "id": "render-no-overflow",
      "severity": "soft",
      "description": "渲染 0 溢出 + 对比度 AA（双视口检查）"
    },
    {
      "id": "outline-match",
      "severity": "soft",
      "description": "章节大纲与 output-templates/cycle-positioning.json 逐项对照"
    }
  ],
  "maxRepairRounds": 2,
  "notes": "硬门未过 → 完成被阻断并返回修正指引；软门 → 警告放行（gate_warnings）；通过后产出 0-100 质量分烙进任务标题（质 NN）。建议落盘 GATE 文件（哈希 + 抽样截图）。"
}
